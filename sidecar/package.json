{
  "name": "@astral/sidecar",
  "version": "0.0.1-beta",
  "private": true,
  "type": "module",
  "description": "Astral agent runtime — Node + AgentScope, speaks newline-delimited JSON over stdio.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "smoke": "node dist/smoke/run.js",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@agentscope-ai/agentscope": "0.0.15",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
